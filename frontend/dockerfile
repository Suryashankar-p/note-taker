# PROD Docker file
# PROD Docker file
# Stage 1: Build
# Stage 1: Build React app
# Stage 1: Build the React app
# --- Stage 1: Build React App ---
    FROM node:20 as builder

    # Build-time variables
    ARG VITE_ENABLE_SSO
    ARG VITE_FIRST_USER_EMAIL
    ARG VITE_DOMAIN
    ARG VITE_URL_PREFIX
    ARG VITE_BACKEND_SSO_URL
    ARG VITE_BACKEND_THERMAX_GPT_URL
    ARG VITE_BACKEND_DOCTOR_CONBOT_URL
    ARG VITE_BACKEND_TROUBLESHOOTING_URL
    ARG VITE_BACKEND_SALES_URL
    ARG VITE_BACKEND_TBWES_OCR_URL
    
    # Runtime variables to inject into env.js
    ENV VITE_ENABLE_SSO=${VITE_ENABLE_SSO}
    ENV VITE_FIRST_USER_EMAIL=${VITE_FIRST_USER_EMAIL}
    ENV VITE_DOMAIN=${VITE_DOMAIN}
    ENV VITE_URL_PREFIX=${VITE_URL_PREFIX}
    ENV VITE_BACKEND_SSO_URL=${VITE_BACKEND_SSO_URL}
    ENV VITE_BACKEND_THERMAX_GPT_URL=${VITE_BACKEND_THERMAX_GPT_URL}
    ENV VITE_BACKEND_DOCTOR_CONBOT_URL=${VITE_BACKEND_DOCTOR_CONBOT_URL}
    ENV VITE_BACKEND_TROUBLESHOOTING_URL=${VITE_BACKEND_TROUBLESHOOTING_URL}
    ENV VITE_BACKEND_SALES_URL=${VITE_BACKEND_SALES_URL}
    ENV VITE_BACKEND_TBWES_OCR_URL=${VITE_BACKEND_TBWES_OCR_URL}
    
    WORKDIR /app
    
    COPY package*.json ./
    RUN npm install
    
    COPY . .
    RUN npm run build
    
    # --- Stage 2: Serve with Nginx ---
    FROM nginx:alpine
    
    COPY --from=builder /app/dist /usr/share/nginx/html
    COPY nginx/nginx.conf /etc/nginx/nginx.conf
    COPY entrypoint.sh /entrypoint.sh
    RUN chmod +x /entrypoint.sh
    
    ENTRYPOINT ["/entrypoint.sh"]