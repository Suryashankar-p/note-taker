FROM node:20 as frontend
ARG VITE_ENABLE_SSO
ARG VITE_FIRST_USER_EMAIL
ARG VITE_DOMAIN
ARG VITE_URL_PREFIX
ARG VITE_BACKEND_SSO_URL
ENV VITE_ENABLE_SSO=${VITE_ENABLE_SSO}
ENV VITE_FIRST_USER_EMAIL=${VITE_FIRST_USER_EMAIL}
ENV VITE_DOMAIN=${VITE_DOMAIN}
ENV VITE_URL_PREFIX=${VITE_URL_PREFIX}
ENV VITE_BACKEND_SSO_URL=${VITE_BACKEND_SSO_URL}
WORKDIR /frontend/
COPY ./frontend/package.json /frontend/package.json
RUN npm install
COPY ./frontend/tsconfig.json ./frontend/postcss.config.js ./frontend/tailwind.config.js ./frontend/tsconfig.node.json ./frontend/vite.config.ts ./frontend/index.html ./frontend/.eslintrc.cjs /frontend/
COPY ./frontend/src/ /frontend/src/
COPY ./frontend/public/ /frontend/public/
RUN echo "VITE_ENABLE_SSO=$VITE_ENABLE_SSO" >> .env.production && \
    echo "VITE_FIRST_USER_EMAIL=$VITE_FIRST_USER_EMAIL" >> .env.production && \
    echo "VITE_DOMAIN=$VITE_DOMAIN" >> .env.production && \
    echo "VITE_URL_PREFIX=$VITE_URL_PREFIX" >> .env.production && \
    echo "VITE_BACKEND_SSO_URL=$VITE_BACKEND_SSO_URL" >> .env.production && \
    RUN npm run build --mode production
# RUN npm run build

FROM nginx
# ARG BACKEND_PORT
# ENV BACKEND_PORT=${BACKEND_PORT}
COPY --from=frontend /frontend/dist /usr/share/nginx/html
COPY ./nginx/nginx-prod.conf /etc/nginx/nginx.conf
# RUN envsubst < /etc/nginx/nginx.conf > /etc/nginx/nginx.conf
CMD ["nginx", "-g", "daemon off;"]