FROM node:20-alpine AS builder

# Build-time variables
ARG ENABLE_SSO
ARG ADMIN_USER_EMAIL
ARG DOMAIN
ARG URL_PREFIX
ARG BACKEND_SSO_URL
ARG BACKEND_THERMAX_GPT_URL
ARG BACKEND_DOCTOR_CONBOT_URL
ARG BACKEND_SMART_TROUBLESHOOT_URL
ARG BACKEND_SALES_URL
ARG BACKEND_TBWES_OCR_URL
ARG BACKEND_CYBERBUDDY_URL
ARG ROOT_PATH

ENV ENABLE_SSO=${ENABLE_SSO}
ENV ADMIN_USER_EMAIL=${ADMIN_USER_EMAIL}
ENV DOMAIN=${DOMAIN}
ENV URL_PREFIX=${URL_PREFIX}
ENV BACKEND_SSO_URL=${BACKEND_SSO_URL}
ENV BACKEND_THERMAX_GPT_URL=${BACKEND_THERMAX_GPT_URL}
ENV BACKEND_DOCTOR_CONBOT_URL=${BACKEND_DOCTOR_CONBOT_URL}
ENV BACKEND_SMART_TROUBLESHOOT_URL=${BACKEND_SMART_TROUBLESHOOT_URL}
ENV BACKEND_SALES_URL=${BACKEND_SALES_URL}
ENV BACKEND_TBWES_OCR_URL=${BACKEND_TBWES_OCR_URL}
ENV BACKEND_CYBERBUDDY_URL=${BACKEND_CYBERBUDDY_URL}
ENV ROOT_PATH={ROOT_PATH}

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.25-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/nginx.staging.conf /etc/nginx/nginx.conf
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
