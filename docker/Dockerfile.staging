FROM node:20-alpine AS builder

# Build-time variables
ARG VITE_ENABLE_SSO
ARG VITE_ADMIN_USER_EMAIL
ARG VITE_DOMAIN
ARG VITE_URL_PREFIX
ARG VITE_BACKEND_SSO_URL
ARG VITE_BACKEND_THERMAX_GPT_URL
ARG VITE_BACKEND_DOCTOR_CONBOT_URL
ARG VITE_BACKEND_SMART_TROUBLESHOOT_URL
ARG VITE_BACKEND_SALES_URL
ARG VITE_BACKEND_TBWES_OCR_URL
ARG VITE_BACKEND_CYBERBUDDY_URL
ARG VITE_BACKEND_HEATING_OCR_URL
ARG VITE_BACKEND_TRANSMITTER_OCR_URL
ARG VITE_BACKEND_DOCUMENT_TRANSLATOR_URL
ARG VITE_BACKEND_EDGE_URL
ARG VITE_BACKEND_CCTV_ANALYTICS_URL
ARG VITE_BACKEND_PRICING_ANALYTICS_URL

ENV VITE_ENABLE_SSO=${VITE_ENABLE_SSO}
ENV VITE_ADMIN_USER_EMAIL=${VITE_ADMIN_USER_EMAIL}
ENV VITE_DOMAIN=${VITE_DOMAIN}
ENV VITE_URL_PREFIX=${VITE_URL_PREFIX}
ENV VITE_BACKEND_SSO_URL=${VITE_BACKEND_SSO_URL}
ENV VITE_BACKEND_THERMAX_GPT_URL=${VITE_BACKEND_THERMAX_GPT_URL}
ENV VITE_BACKEND_DOCTOR_CONBOT_URL=${VITE_BACKEND_DOCTOR_CONBOT_URL}
ENV VITE_BACKEND_SMART_TROUBLESHOOT_URL=${VITE_BACKEND_SMART_TROUBLESHOOT_URL}
ENV VITE_BACKEND_SALES_URL=${VITE_BACKEND_SALES_URL}
ENV VITE_BACKEND_TBWES_OCR_URL=${VITE_BACKEND_TBWES_OCR_URL}
ENV VITE_BACKEND_CYBERBUDDY_URL=${VITE_BACKEND_CYBERBUDDY_URL}
ENV VITE_BACKEND_HEATING_OCR_URL=${VITE_BACKEND_HEATING_OCR_URL}
ENV VITE_BACKEND_TRANSMITTER_OCR_URL=${VITE_BACKEND_TRANSMITTER_OCR_URL}
ENV VITE_BACKEND_DOCUMENT_TRANSLATOR_URL=${VITE_BACKEND_DOCUMENT_TRANSLATOR_URL}
ENV VITE_BACKEND_EDGE_URL=${VITE_BACKEND_EDGE_URL}
ENV VITE_BACKEND_PRICING_ANALYTICS_URL=${VITE_BACKEND_PRICING_ANALYTICS_URL}

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm install --legacy-peer-deps

FROM nginx:1.25-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/nginx.staging.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
